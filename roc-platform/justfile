# list this example's recipes
_default:
    @ just --list --unsorted

# build the host archive and link the system libraries roc needs
build:
    bash build.sh

# run a Roc example from its directory, where its shaders_source_dir resolves; roc watches the sources and hot-reloads on change
run example="basic-triangle": build
    cd "examples/{{example}}" && roc main.roc

# build an optimized standalone executable for an example
exe example="basic-triangle": build
    cd "examples/{{example}}" && roc build main.roc

# build the platform and run every example headlessly
test:
    bash ci/all_tests.sh

# format-check the Roc sources, then check and test the platform modules and render graph tests
roc-test:
    #!/usr/bin/env bash
    set -euo pipefail
    roc fmt --check platform platform-tests examples
    for module in platform/*.roc; do roc check "$module"; done
    for module in RasterState RenderGraphValidate; do roc test "platform/$module.roc"; done
    roc check --main=platform-tests/main.roc platform-tests/RenderGraphTests.roc
    roc test --main=platform-tests/main.roc platform-tests/RenderGraphTests.roc
    roc check --main=platform-tests/main.roc platform-tests/ForeignSelection.roc
    # selecting, drawing, or submitting another set's graph must crash, not submit a foreign graph id
    if output="$(roc test --main=platform-tests/main.roc platform-tests/ForeignSelection.roc 2>&1)"; then
        echo "ForeignSelection.roc should crash in GraphSet.select, GraphSet.draw, and Game.new's draw" >&2
        exit 1
    fi
    grep -q "GraphSet chose a graph (id 1) this set did not register" <<< "$output"
    grep -q "GraphSet chose a graph (id 0) this set did not register" <<< "$output"
    grep -q "draw submitted a graph (id 0) from a set other than the one Game.new registered" <<< "$output"
    grep -q "3 failed" <<< "$output"

# bundle the platform into dist/<hash>.tar.zst
bundle:
    bash bundle.sh

# serve the bundle and prove it runs from a URL in an ubuntu:24.04 container
bundle-test:
    bash ci/bundle_test.sh

# remove the cargo build output, the host test build output, the host archive, and the bundle
clean:
    cargo clean
    cargo clean --manifest-path tests/lifecycle/Cargo.toml
    rm -rf dist
    rm -f platform/targets/*/libhost.a

# regenerate the committed link inputs; asserts the glibc floor, needs gcc and binutils
stubs:
    bash stubs/generate.sh

# regenerate platform/LICENSES from the toolchain and the dependency graph
licenses:
    bash ci/licenses.sh

# regenerate src/roc_platform_abi.rs from platform/main.roc with the installed rust_glue shorthand
glue:
    roc glue rust_glue ./src/ platform/main.roc

# regenerate every example's Roc shader modules and SPIR-V, or one by name
roc-shaders example="all":
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{example}}" = "all" ]; then
        for d in examples/*/; do cargo run -p mltrs-cli --manifest-path ../Cargo.toml -- shaders compile --crate-dir "$d"; done
    else
        cargo run -p mltrs-cli --manifest-path ../Cargo.toml -- shaders compile --crate-dir "examples/{{example}}"
    fi

# record the roc version the platform was last built with
record-roc-version:
    roc version > built_with_roc_version.txt
