# list this example's recipes
_default:
    @ just --list --unsorted

# build the host archive and link the system libraries roc needs
build: record-roc-version
    bash build.sh

# run a Roc example with the dev backend; roc watches the sources and hot-reloads on change
run example="basic-triangle": build
    roc "examples/{{example}}/main.roc"

# build an optimized standalone executable for an example
exe example="basic-triangle": build
    cd "examples/{{example}}" && roc build main.roc

# build the platform and run every example headlessly
test: record-roc-version
    bash ci/all_tests.sh

# bundle the platform into dist/<hash>.tar.zst
bundle: record-roc-version
    bash bundle.sh

# serve the bundle and prove it runs from a URL in an ubuntu:24.04 container
bundle-test:
    bash ci/bundle_test.sh

# regenerate the committed link inputs; asserts the glibc floor, needs gcc and binutils
stubs:
    bash stubs/generate.sh

# regenerate platform/LICENSES from the toolchain and the dependency graph
licenses:
    bash ci/licenses.sh

# regenerate src/roc_platform_abi.rs from platform/main.roc with the installed rust_glue shorthand
glue: record-roc-version
    roc glue rust_glue ./src/ platform/main.roc

# regenerate every example's Roc shader modules and SPIR-V, or one by name
shaders example="all":
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{example}}" = "all" ]; then
        for d in examples/*/; do cargo run -p mltrs-cli --manifest-path ../Cargo.toml -- shaders compile --crate-dir "$d"; done
    else
        cargo run -p mltrs-cli --manifest-path ../Cargo.toml -- shaders compile --crate-dir "examples/{{example}}"
    fi

# record the roc version the platform was last built with
record-roc-version:
    roc version > built_with_roc_version.txt
