{%- for module_name in shared_module_names -%}
pub mod {{ module_name }};
{%~ endfor -%}
{%- for module_name in module_names -%}
pub mod {{ module_name }};
{%~ endfor -%}
{%- for module_name in compute_module_names -%}
pub mod {{ module_name }};
{%~ endfor +%}

// a convenience aggregate; consumers may instead construct the per-shader
// `Shader::init()` types directly, so an unused atlas is not a defect
#[allow(dead_code)]
pub struct ShaderAtlas {
{%- for (field_name, type_prefix) in entries +%}
    pub {{ field_name }}: {{type_prefix}}Shader,
{%- endfor -%}
{%- for (field_name, type_prefix) in compute_entries +%}
    pub {{ field_name }}: {{type_prefix}}Shader,
{%- endfor +%}
}

#[allow(dead_code)]
impl ShaderAtlas {
    pub fn init() -> Self {
        Self {
{%- for (field_name, type_prefix) in entries +%}
            {{ field_name }}: {{ type_prefix }}Shader::init(),
{%- endfor -%}
{%- for (field_name, type_prefix) in compute_entries +%}
            {{ field_name }}: {{ type_prefix }}Shader::init(),
{%- endfor +%}
        }
    }
}
