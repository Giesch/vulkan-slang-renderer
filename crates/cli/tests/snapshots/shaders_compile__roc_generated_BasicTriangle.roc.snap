import pf.ShaderReflection exposing [BlockSchema, ElementPacker, Float3, GraphicsReflection, GraphicsShader, ImmutableBufferBinding, NoPush, PointerAddress, StructType, UniformSlot, UniformSpec]

import Mltrs

import "../compiled with space/basic_triangle.vert.spv" as vertex_bytes : List(U8)
import "../compiled with space/basic_triangle.frag.spv" as fragment_bytes : List(U8)
import "../compiled with space/basic_triangle.json" as reflection_json : Str

## Generated shader types, GPU byte packers, block schemas, and reflection.
BasicTriangle := {}.{
	TriangleParams := {
		mvp : Mltrs.MvpMatrices,
		vertices : PointerAddress,
	}.{
		is_eq : _

		gpu_size : U32
		gpu_size = 208

		to_bytes : TriangleParams -> List(U8)
		to_bytes = |value|
			ShaderReflection.pack(
				gpu_size.to_u64(),
				[
					(0, Mltrs.MvpMatrices.to_bytes(value.mvp)),
					(192, PointerAddress.to_bytes(value.vertices)),
				],
			)

		packer : ElementPacker(TriangleParams)
		packer = { stride: gpu_size, to_bytes }

		schema : BlockSchema(TriangleParamsData, TriangleParamsBindings)
		schema = {
			name: "TriangleParams",
			gpu_size: 208,
			data_size: 192,
			resource_fields: [BufAddr],
			fields: [
				{ key: 1, offset: 0, len: 192, kind: Data({ src_offset: 0 }) },
				{ key: 0, offset: 192, len: 8, kind: BufAddr },
			],
			pack_data: TriangleParamsData.to_bytes,
			extract_bindings: |bindings| [
				(0, bindings.vertices.erase()),
			],
		}
	}

	TriangleParamsBindings : {
		vertices : ImmutableBufferBinding(Vertex),
	}

	TriangleParamsData := {
		mvp : Mltrs.MvpMatrices,
	}.{
		is_eq : _

		gpu_size : U32
		gpu_size = 192

		to_bytes : TriangleParamsData -> List(U8)
		to_bytes = |value|
			ShaderReflection.pack(
				gpu_size.to_u64(),
				[
					(0, Mltrs.MvpMatrices.to_bytes(value.mvp)),
				],
			)

		packer : ElementPacker(TriangleParamsData)
		packer = { stride: gpu_size, to_bytes }
	}

	Vertex := {
		position : Float3,
		color : Float3,
	}.{
		is_eq : _

		gpu_size : U32
		gpu_size = 32

		to_bytes : Vertex -> List(U8)
		to_bytes = |value|
			ShaderReflection.pack(
				gpu_size.to_u64(),
				[
					(0, Float3.to_bytes(value.position)),
					(16, Float3.to_bytes(value.color)),
				],
			)

		packer : ElementPacker(Vertex)
		packer = { stride: gpu_size, to_bytes }
	}

	mvp_matrices_type : StructType
	mvp_matrices_type = StructType.{
		type_name: "MVPMatrices",
		fields: [
			Matrix({
				field_name: "model",
				binding: Uniform({
					offset: 0,
					size: 64,
				}),
				row_count: 4,
				column_count: 4,
				element_type: Scalar({
					scalar_type: Float32,
				}),
			}),
			Matrix({
				field_name: "view",
				binding: Uniform({
					offset: 64,
					size: 64,
				}),
				row_count: 4,
				column_count: 4,
				element_type: Scalar({
					scalar_type: Float32,
				}),
			}),
			Matrix({
				field_name: "proj",
				binding: Uniform({
					offset: 128,
					size: 64,
				}),
				row_count: 4,
				column_count: 4,
				element_type: Scalar({
					scalar_type: Float32,
				}),
			}),
		],
	}

	triangle_params_type : StructType
	triangle_params_type = StructType.{
		type_name: "TriangleParams",
		fields: [
			Struct({
				field_name: "mvp",
				binding: Uniform({
					offset: 0,
					size: 192,
				}),
				struct_type: mvp_matrices_type,
			}),
			Pointer({
				field_name: "vertices",
				binding: Uniform({
					offset: 192,
					size: 8,
				}),
				pointee_type: vertex_type,
				pointee_size: 32,
				access: Immutable,
			}),
		],
	}

	vertex_type : StructType
	vertex_type = StructType.{
		type_name: "Vertex",
		fields: [
			Vector(
				Bound({
					field_name: "position",
					binding: Uniform({
						offset: 0,
						size: 12,
					}),
					element_count: 3,
					element_type: Scalar({
						scalar_type: Float32,
					}),
				}),
			),
			Vector(
				Bound({
					field_name: "color",
					binding: Uniform({
						offset: 16,
						size: 12,
					}),
					element_count: 3,
					element_type: Scalar({
						scalar_type: Float32,
					}),
				}),
			),
		],
	}

	reflection : GraphicsReflection
	reflection = {
		source_file_name: "basic_triangle.shader.slang",
		global_parameters: [
			ParameterBlock({
				parameter_name: "params",
				element_type: triangle_params_type,
			}),
		],
		vertex_entry_point: {
			entry_point_name: "vertexMain",
			stage: Vertex,
			parameters: [
				Scalar(
					Semantic({
						parameter_name: "vertexId",
						semantic_name: "SV_VERTEXID",
						scalar_type: Uint32,
					}),
				),
			],
		},
		fragment_entry_point: {
			entry_point_name: "fragmentMain",
			stage: Fragment,
			parameters: [
				Struct({
					parameter_name: "fragVertex",
					binding: Some(
						VaryingInput({
							index: 0,
							count: 1,
						}),
					),
					type_name: "FragInput",
					fields: [
						Vector(
							Semantic({
								field_name: "position",
								semantic_name: "SV_POSITION",
								element_count: 4,
								element_type: Scalar({
									scalar_type: Float32,
								}),
							}),
						),
						Vector(
							Bound({
								field_name: "color",
								binding: VaryingInput({
									index: 0,
									count: 1,
								}),
								element_count: 3,
								element_type: Scalar({
									scalar_type: Float32,
								}),
							}),
						),
					],
				}),
			],
		},
		pipeline_layout: {
			descriptor_set_layouts: [
				{
					binding_ranges: [
						{
							binding: 0,
							descriptor_type: ConstantBuffer,
							descriptor_count: 1,
							stage_flags: All,
							size: 208,
						},
					],
				},
			],
			push_constant_ranges: [],
			bindless_heap_set: None,
		},
	}

	stages = {
		vertex: vertex_bytes,
		fragment: fragment_bytes,
	}

	params : UniformSpec(TriangleParamsData, TriangleParamsBindings)
	params = {
		parameter_name: "params",
		index: 0,
		schema: TriangleParams.schema,
	}

	shader : GraphicsShader(
		{
			params : UniformSlot(TriangleParamsData, TriangleParamsBindings),
		},
		NoPush,
	)
	shader = GraphicsShader.{
		name: "basic_triangle",
		vertex_spv: vertex_bytes,
		fragment_spv: fragment_bytes,
		reflection_json,
		reflection,
		uniform_slots: |slots| [slots.params.index()],
		push: NoPush.{},
	}
}
