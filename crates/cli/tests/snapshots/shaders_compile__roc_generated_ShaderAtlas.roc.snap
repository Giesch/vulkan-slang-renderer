import BasicTriangle
import Particles

## Generated; directories are tool-owned.
ShaderAtlas := {}.{

	## The shader sources, relative to the Roc project root.
	shaders_source_dir : Str
	shaders_source_dir = "shaders/source"

	shader_names : List(Str)
	shader_names = ["basic_triangle", "particles"]

	basic_triangle = {
		reflection: BasicTriangle.reflection,
		stages: BasicTriangle.stages,
	}

	particles = {
		reflection: Particles.reflection,
		stages: Particles.stages,
	}
}
