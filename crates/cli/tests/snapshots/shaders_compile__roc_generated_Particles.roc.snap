## Generated; logical values are not GPU memory layouts.
Particles := {}.{
	SimParams := {
		particles_in : PointerAddress,
		particles_out : PointerAddress,
		delta_time : F32,
	}.{
		is_eq : _

		gpu_size : U32
		gpu_size = 32

		to_bytes : SimParams -> List(U8)
		to_bytes = |value|
			ShaderReflection.pack(
				gpu_size.to_u64(),
				[
					(0, PointerAddress.to_bytes(value.particles_in)),
					(8, PointerAddress.to_bytes(value.particles_out)),
					(16, ShaderReflection.f32_bytes(value.delta_time)),
				],
			)
	}

	particle_type : StructType
	particle_type = StructType.{
