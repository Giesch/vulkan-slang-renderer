import pf.ShaderReflection exposing [BlockSchema, BufferBinding, ComputeReflection, ComputeShader, ElementPacker, NoPush, PointerAddress, ReadBufferBinding, StructType, UniformSlot, UniformSpec]

import Particle

import "../compiled with space/particles.comp.spv" as compute_bytes : List(U8)
import "../compiled with space/particles.comp.json" as reflection_json : Str

## Generated shader types, GPU byte packers, block schemas, and reflection.
Particles := {}.{
	SimParams := {
		particles_in : PointerAddress,
		particles_out : PointerAddress,
		delta_time : F32,
	}.{
		is_eq : _

		gpu_size : U32
		gpu_size = 32

		to_bytes : SimParams -> List(U8)
		to_bytes = |value|
			ShaderReflection.pack(
				gpu_size.to_u64(),
				[
					(0, PointerAddress.to_bytes(value.particles_in)),
					(8, PointerAddress.to_bytes(value.particles_out)),
					(16, ShaderReflection.f32_bytes(value.delta_time)),
				],
			)

		packer : ElementPacker(SimParams)
		packer = { stride: gpu_size, to_bytes }

		schema : BlockSchema(SimParamsData, SimParamsBindings)
		schema = {
			name: "SimParams",
			gpu_size: 32,
			data_size: 4,
			resource_fields: [BufAddr, BufAddr],
			fields: [
				{ key: 0, offset: 0, len: 8, kind: BufAddr },
				{ key: 1, offset: 8, len: 8, kind: BufAddr },
				{ key: 2, offset: 16, len: 4, kind: Data({ src_offset: 0 }) },
			],
			pack_data: SimParamsData.to_bytes,
			extract_bindings: |bindings| [
				(0, bindings.particles_in.erase()),
				(1, bindings.particles_out.erase()),
			],
		}
	}

	SimParamsBindings : {
		particles_in : ReadBufferBinding(Particle.Particle),
		particles_out : BufferBinding(Particle.Particle),
	}

	SimParamsData := {
		delta_time : F32,
	}.{
		is_eq : _

		gpu_size : U32
		gpu_size = 4

		to_bytes : SimParamsData -> List(U8)
		to_bytes = |value|
			ShaderReflection.pack(
				gpu_size.to_u64(),
				[
					(0, ShaderReflection.f32_bytes(value.delta_time)),
				],
			)

		packer : ElementPacker(SimParamsData)
		packer = { stride: gpu_size, to_bytes }
	}

	particle_type : StructType
	particle_type = StructType.{
		type_name: "Particle",
		fields: [
			Vector(
				Bound({
					field_name: "position",
					binding: Uniform({
						offset: 0,
						size: 8,
					}),
					element_count: 2,
					element_type: Scalar({
						scalar_type: Float32,
					}),
				}),
			),
			Vector(
				Bound({
					field_name: "velocity",
					binding: Uniform({
						offset: 8,
						size: 8,
					}),
					element_count: 2,
					element_type: Scalar({
						scalar_type: Float32,
					}),
				}),
			),
			Vector(
				Bound({
					field_name: "color",
					binding: Uniform({
						offset: 16,
						size: 16,
					}),
					element_count: 4,
					element_type: Scalar({
						scalar_type: Float32,
					}),
				}),
			),
		],
	}

	sim_params_type : StructType
	sim_params_type = StructType.{
		type_name: "SimParams",
		fields: [
			Pointer({
				field_name: "particlesIn",
				binding: Uniform({
					offset: 0,
					size: 8,
				}),
				pointee_type: particle_type,
				pointee_size: 32,
				access: Read,
			}),
			Pointer({
				field_name: "particlesOut",
				binding: Uniform({
					offset: 8,
					size: 8,
				}),
				pointee_type: particle_type,
				pointee_size: 32,
				access: ReadWrite,
			}),
			Scalar({
				field_name: "deltaTime",
				binding: Uniform({
					offset: 16,
					size: 4,
				}),
				scalar_type: Float32,
			}),
		],
	}

	reflection : ComputeReflection
	reflection = {
		source_file_name: "particles.compute.slang",
		global_parameters: [
			ParameterBlock({
				parameter_name: "simParams",
				element_type: sim_params_type,
			}),
		],
		compute_entry_point: {
			entry_point_name: "computeMain",
			stage: Compute,
			parameters: [],
		},
		workgroup_size: {
			x: 256,
			y: 1,
			z: 1,
		},
		pipeline_layout: {
			descriptor_set_layouts: [
				{
					binding_ranges: [
						{
							binding: 0,
							descriptor_type: ConstantBuffer,
							descriptor_count: 1,
							stage_flags: All,
							size: 32,
						},
					],
				},
			],
			push_constant_ranges: [],
			bindless_heap_set: None,
		},
	}

	stages = {
		compute: compute_bytes,
	}

	sim_params : UniformSpec(SimParamsData, SimParamsBindings)
	sim_params = {
		parameter_name: "simParams",
		index: 0,
		schema: SimParams.schema,
	}

	shader : ComputeShader(
		{
			sim_params : UniformSlot(SimParamsData, SimParamsBindings),
		},
		NoPush,
	)
	shader = ComputeShader.{
		name: "particles",
		compute_spv: compute_bytes,
		reflection_json,
		reflection,
		workgroup_size: reflection.workgroup_size,
		uniform_slots: |slots| [slots.sim_params.index()],
		push: NoPush.{},
	}
}
