# Recipes for the toon_link example, invoked from the repo root as
# `just toon_link <recipe>` (the root justfile declares this dir as a module).
#
# NOTE just runs a submodule's recipes with the working directory set to the
# submodule's directory, so every path below is relative to
# examples/toon_link/. `cargo` still finds the workspace root by walking up.

# list this example's recipes
_default:
    @ just --list --unsorted


# prepare and verify all Wind Waker assets for a new clone (requires TWW_DIR)
[unix]
tww-assets:
    just extract-link convert-link
    just verify-assets
    @echo "TWW ASSETS VERIFIED"

# verify assets quietly; pass --verbose for successful check logs (requires TWW_DIR)
[unix]
verify-assets verbosity='--quiet':
    @./scripts/run_asset_check.rs {{quote(verbosity)}} -- just _link-verify-model _link-verify-animations


# extract Link assets from the tww disc image (requires TWW_DIR)
[unix]
extract-link:
    ./scripts/extract_link.sh

# parse Link's BDL and emit converted assets (P1: chunk walk only)
[unix]
convert-link *args:
    cargo run -p convert-link --bin convert_link -- assets/link/raw assets/link/converted {{args}}

# Check freshly converted model bytes, never stale output or auto-promoted goldens.
[unix]
link-verify-goldens:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! sha256sum --check --quiet scripts/link_assets.sha256; then
        echo 'Link raw assets missing or changed; run `just toon_link extract-link` with TWW_DIR set.' >&2
        exit 1
    fi
    output=$(mktemp -d)
    trap 'rm -rf "$output"' EXIT
    cargo run -p convert-link --bin convert_link -- assets/link/raw "$output"
    golden="$PWD/scripts/link_converted.sha256"
    (cd "$output" && sha256sum --check "$golden")
    echo "MODEL GOLDENS VERIFIED"

# Complete local model gate; pass --verbose for successful check logs.
[unix]
link-verify-model verbosity='--quiet':
    @./scripts/run_asset_check.rs {{quote(verbosity)}} -- just _link-verify-model

[unix]
_link-verify-model: link-verify-goldens link-verify-p1 link-verify-p2 link-verify-p3
    echo "MODEL VERIFIED"


# P1 gate: diff our --info chunk table against the gclib oracle, then run ignored tests
[unix]
link-verify-p1:
    #!/usr/bin/env bash
    set -euo pipefail
    diff <(just convert-link --info) <(./scripts/link_chunk_table.py assets/link/raw/cl.bdl)
    cargo test -p convert-link -- --include-ignored
    echo "P1 VERIFIED"

# P2 texture gate: pixel-diff every decoded texture against gclib
[unix]
link-verify-textures:
    #!/usr/bin/env bash
    set -euo pipefail
    just convert-link >/dev/null
    ./scripts/link_texture_diff.py assets/link/raw assets/link/converted/tex

# P2 MAT3 gate: diff our canonical --dump-mat3 against the gclib oracle
[unix]
link-verify-mat3:
    #!/usr/bin/env bash
    set -euo pipefail
    diff <(just convert-link --dump-mat3) <(./scripts/link_mat3_table.py assets/link/raw/cl.bdl)
    echo "MAT3 table matches oracle"

# P2 gate: textures + MAT3 + ignored real-file tests
[unix]
link-verify-p2: link-verify-textures link-verify-mat3
    cargo test -p convert-link -- --include-ignored
    echo "P2 VERIFIED"

# P3 geometry gate: diff our canonical --dump-geometry against the oracle,
# then run the full conversion (which runs the baking invariants)
[unix]
link-verify-geometry:
    #!/usr/bin/env bash
    set -euo pipefail
    diff <(just convert-link --dump-geometry) <(./scripts/link_geometry_table.py assets/link/raw/cl.bdl)
    just convert-link >/dev/null
    echo "geometry table matches oracle"

# P3 gate: geometry diff + ignored real-file tests
[unix]
link-verify-p3: link-verify-geometry
    cargo test -p convert-link -- --include-ignored
    echo "P3 VERIFIED"


# resolve the actor lighting colors this example lerps between; pass
# --room/--weather/--time to read a different palette slot
[unix]
link-env-colors *args:
    ./scripts/link_env_colors.py assets/link/raw/sea_stage.dzs {{args}}


# extract Link body/face animations (BCK/BTP/BTK) from the GZLE01 disc into
# assets/link/animations/raw; verifies against the frozen goldens in scripts/
# (requires TWW_DIR). Bootstrap
# candidate manifests for review with `just toon_link extract-link-animations --bootstrap`
[unix]
extract-link-animations *args:
    uv run --no-project scripts/extract_link_animations.py {{args}}


# convert the extracted animation raws into the shared gx JSON schema
# (assets/link/animations/raw -> assets/link/animations/converted)
[unix]
convert-link-animations *args:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build -p convert-link --bin convert_link_animations
    ../../target/debug/convert_link_animations assets/link/animations/raw assets/link/animations/converted {{args}}


# asset-free animation tests: synthetic fixtures only, no game assets.
# Needs uv to resolve the pinned gclib dependency for the python harness.
[unix]
link-test-animations:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo test -p gx
    cargo test -p convert-link animation
    cargo test -p convert-link --test animation_cli
    cargo build -p convert-link --bin convert_link_animations
    CONVERT_LINK_ANIMATIONS=../../target/debug/convert_link_animations uv run --no-project scripts/tests/run_tests.py
    echo "ANIMATION TESTS OK"


# GPU skinning oracle (AC10): run the production skinning.slang helpers on
# lavapipe over synthetic fixtures and compare with the CPU reference. Needs
# no game assets. Fails loudly (never skips) without lavapipe or SDL offscreen.
[unix]
test-skinning-gpu:
    #!/usr/bin/env bash
    set -euo pipefail
    lvp_icd=
    for candidate in /usr/share/vulkan/icd.d/lvp_icd*.json; do
        [ -r "$candidate" ] && lvp_icd=$candidate && break
    done
    if [ -z "$lvp_icd" ]; then
        echo "FAIL: no lavapipe ICD in /usr/share/vulkan/icd.d (install mesa-vulkan-drivers)" >&2
        exit 1
    fi
    # A filter that matches nothing exits 0, so also require the test's own
    # marker. Grep the saved log rather than the pipe: `grep -q` on the pipe
    # would SIGPIPE `tee` and trip pipefail with exit 141.
    log=$(mktemp)
    trap 'rm -f "$log"' EXIT
    SDL_VIDEODRIVER=offscreen VK_ICD_FILENAMES=$lvp_icd RUST_LOG=${RUST_LOG:-warn} \
        cargo test -p toon_link -- --ignored --exact --nocapture skinning::tests::skinning_gpu_oracle \
        2>&1 | tee "$log"
    grep -q '^SKINNING_GPU_ORACLE_OK' "$log"
    echo "SKINNING GPU ORACLE OK"


# real-asset animation gate: extraction + raw checks, full oracle parity,
# converted hashes + repeatability, tamper detection, model-gate isolation.
# Fails when the assets or prerequisites are missing (run extract first).
[unix]
link-verify-animations verbosity='--quiet':
    @./scripts/run_asset_check.rs {{quote(verbosity)}} -- just _link-verify-animations

[unix]
_link-verify-animations:
    #!/usr/bin/env bash
    set -euo pipefail
    just extract-link-animations
    cargo build -p convert-link --bin convert_link_animations
    uv run --no-project scripts/link_animation_verify.py --converter ../../target/debug/convert_link_animations
    echo "ANIMATIONS VERIFIED"
