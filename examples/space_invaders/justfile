# Recipes for the space_invaders example, invoked from the repo root as
# `just space_invaders <recipe>` (the root justfile declares this dir as a
# module).
#
# NOTE just runs a submodule's recipes with the working directory set to the
# submodule's directory, so the cd below is relative to
# examples/space_invaders/.

# list this example's recipes
_default:
    @ just --list --unsorted

# export the aseprite files as one sprite sheet
#
# NOTE `&& textures` is just's deferred dependency: the encode runs after the
# sheet it reads has been rewritten.
[unix]
sprites: && textures
    cd textures/space_invaders && aseprite --batch *.aseprite \
        --sheet sprite_sheet.png \
        --data sprite_sheet.json \
        --filename-format "{title} {frame}" \
        --format json-array

# encode the sprite sheet losslessly, single level (see serenity_crt/justfile)
[unix]
textures:
    ctt textures/space_invaders/sprite_sheet.png \
        -o textures/space_invaders/sprite_sheet.ktx2 \
        -f rgba8unorm --zstd=19
