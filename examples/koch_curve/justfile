# Recipes for the koch_curve example, invoked from the repo root as
# `just koch_curve <recipe>` (the root justfile declares this dir as a module).
#
# NOTE just runs a submodule's recipes with the working directory set to the
# submodule's directory, so every path below is relative to
# examples/koch_curve/.

# list this example's recipes
_default:
    @ just --list --unsorted

# encode the cube map source as bc7 with a mip chain (4x less vram than rgba8)
#
# NOTE 612x331 is not a multiple of the 4x4 block; the partial blocks are
# handled by the div_ceil sizing in crates/mltrs/src/ktx.rs.
# the un-blurred istockphoto-uffizi-612x612.jpg is referenced by no code.
[unix]
textures:
    ctt textures/istockphoto-uffizi-blurred-612x612.jpg \
        -o textures/istockphoto-uffizi-blurred-612x612.ktx2 \
        -f bc7 --mipmap --quality very-slow --zstd=19
